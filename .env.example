EMAIL_USER=
EMAIL_PASS=
PORT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional WhatsApp alert to the shop owner's own phone via CallMeBot (see netlify/functions/send-invoice.js)
# Format: phone:apikey, comma-separated for several phones
CALLMEBOT_RECIPIENTS=



# Firebase (optional). Leave blank to run with the static catalog and Telegram only.
# Values come from Firebase console -> Project settings -> Your apps -> SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Comma-separated emails allowed into /admin (must match adminEmails() in firestore.rules)
VITE_ADMIN_EMAILS=zarocrackers@gmail.com
# Set to 1 to point the app at local Firebase emulators (firebase emulators:start)
VITE_FIREBASE_USE_EMULATOR=

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX
VITE_GA4_ID=
